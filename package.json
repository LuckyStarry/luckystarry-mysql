{
  "name": "luckystarry-mysql",
  "version": "1.0.1-5",
  "description": "一个轻量易用的 MySQL 客户端。",
  "keywords": [
    "mysql"
  ],
  "main": "dist/index.js",
  "scripts": {
    "prebuild": "del-cli dist -f",
    "build": "tsc",
    "pretest": "del-cli .nyc_output coverage -f",
    "test": "nyc mocha",
    "testonly": "mocha",
    "coverage": "nyc report --reporter=text-lcov | coveralls"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LuckyStarry/luckystarry-mysql.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/LuckyStarry/luckystarry-mysql/issues"
  },
  "homepage": "https://github.com/LuckyStarry/luckystarry-mysql#readme",
  "devDependencies": {
    "@types/chai": "4.3.14",
    "@types/mocha": "^10.0.6",
    "@types/mysql": "^2.15.15",
    "@types/node": "^20.12.11",
    "chai": "^4.4.1",
    "coveralls": "^3.1.0",
    "cross-env": "^7.0.2",
    "del-cli": "^5.1.0",
    "mocha": "^11.0.1",
    "nyc": "^15.1.0",
    "ts-node": "^10.9.2",
    "tslint": "^6.1.3",
    "tslint-config-standard": "^9.0.0",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "mysql": "^2.18.1"
  },
  "nyc": {
    "extension": [
      ".ts"
    ],
    "reporter": [
      "lcov",
      "text",
      "text-summary"
    ],
    "include": [
      "src"
    ],
    "all": true
  }
}
