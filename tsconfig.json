{
  "include": ["src/**/*"],
  "exclude": ["node_modules"],
  "compilerOptions": {
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "module": "commonjs",
    "target": "es5",
    "sourceMap": true,
    "declaration": true,
    "downlevelIteration": true,
    "lib": ["es5", "es2015"],
    "outDir": "dist"
  }
}
